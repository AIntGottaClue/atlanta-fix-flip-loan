---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import {cities,brand,domain} from '../data/cities';
export function getStaticPaths(){return cities.map(c=>({params:{slug:c.slug},props:{city:c}}))}
const {city}=Astro.props;
const url=`https://${domain}/${city.slug}/`;
const faq=[{q:`Can you connect investors with fix and flip funding in ${city.name}?`,a:`Share the ${city.name} property and renovation plan for review. We are not a direct lender and cannot promise a match or approval.`},{q:'Who determines the loan terms?',a:'Any lender determines its own eligibility, terms and documentation for a specific project.'}];
const jsonld=[{'@context':'https://schema.org','@type':'Service',name:`Fix and flip loan connections in ${city.name}`,serviceType:'Investor loan connection service',provider:{'@type':'Organization',name:brand},areaServed:{'@type':'City',name:city.name,containedInPlace:{'@type':'State',name:'Georgia'}},url},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:`https://${domain}/`},{'@type':'ListItem',position:2,name:`${city.name}, GA`,item:url}]}];
---
<Base title={city.title} description={city.description} path={`/${city.slug}/`} jsonld={jsonld}><Header/><main><CityContent cityName={city.name} location={`${city.name}, GA`} intro={city.intro} angle={city.angle} caution={city.caution}/></main><Footer/></Base>
