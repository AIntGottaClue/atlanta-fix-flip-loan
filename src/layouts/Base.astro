---
import '../styles/global.css';
import {brand,domain} from '../data/cities';
interface Props {title:string;description:string;path:string;jsonld?:object[]}
const {title,description,path,jsonld=[]}=Astro.props;
const canonical=`https://${domain}${path}`;
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={brand}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta name="theme-color" content="#f4eee5"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet"/>{jsonld.map(obj=><script is:inline type="application/ld+json" set:html={JSON.stringify(obj)}/>)}<!-- Replace GA4 placeholder with your measurement ID before launch --><script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-XXXXXXXXXX');</script></head><body><slot/><a href="#deal-form" class="fab-deal" aria-label="Submit a project, jump to the form"><span aria-hidden="true">↗</span><strong>Submit project</strong></a><script is:inline src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id="tk_61d238e145314251999b74fdd5c953cf" defer></script></body></html>
